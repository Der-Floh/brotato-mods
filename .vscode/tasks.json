{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build mods",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.vscode/build/build.ps1", "-AllowEmpty"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/build/build.ps1", "-AllowEmpty"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Validate mods",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.vscode/build/validate.ps1"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/build/validate.ps1"]
            },
            "dependsOn": "Build mods",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Workshop descriptions",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.vscode/build/workshop-descriptions.ps1"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/build/workshop-descriptions.ps1"]
            },
            "problemMatcher": []
        },
        {
            "label": "Publish to the Workshop (dry run)",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.github/publish-workshop.ps1", "-DryRun"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/publish-workshop.ps1", "-DryRun"]
            },
            "problemMatcher": []
        },
        {
            "label": "Publish to the Workshop",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.github/publish-workshop.ps1"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/publish-workshop.ps1"]
            },
            "problemMatcher": []
        },
        {
            "label": "Integration tests",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tests/run-integration.ps1"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tests/run-integration.ps1"]
            },
            "problemMatcher": []
        },
        {
            "label": "Fetch third-party mods",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/tests/fetch-third-party.ps1"],
            "windows": {
                "command": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tests/fetch-third-party.ps1"]
            },
            "problemMatcher": []
        }
    ]
}
